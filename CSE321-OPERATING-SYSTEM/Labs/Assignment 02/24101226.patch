+// Task 2: let the calling process set its own ticket count.
+// n must be a positive integer.
+uint64
+sys_settickets(void)
+{
+  int n;
+
+  argint(0, &n);
+  if (n < 1)
+    return -1;
+  myproc()->tickets = n;
+  return 0;
+}
